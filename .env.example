# Banco usado pelos containers (não use estes valores padrão em produção)
DB_DATABASE=day_mendes_store
DOCKER_DB_USER=daymendes
DOCKER_DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# Use uma chave aleatória com pelo menos 32 caracteres
JWT_SECRET_KEY=troque-por-uma-chave-segura-com-pelo-menos-32-caracteres
JWT_ISSUER=DayMendesStore
JWT_AUDIENCE=DayMendesStoreApp
JWT_EXPIRATION_HOURS=2
