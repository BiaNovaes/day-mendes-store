# Configuração local dos containers
DB_DATABASE=day_mendes_store
DOCKER_DB_USER=daymendes
DOCKER_DB_PASSWORD=daymendes_local
DB_ROOT_PASSWORD=daymendes_root_local

# O comando de inicialização troca este valor por uma chave aleatória
JWT_SECRET_KEY=GERAR_AUTOMATICAMENTE
JWT_ISSUER=DayMendesStore
JWT_AUDIENCE=DayMendesStoreApp
JWT_EXPIRATION_HOURS=2
